{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LCD Proxy",
  "version": "0.1.3",
  "identifier": "com.lcdproxy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LCD PROXY",
        "width": 620,
        "height": 800,
        "minWidth": 520,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sing-box"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxRkYxNDg2QTFGMERCMjIKUldRaTIvQ2hoaFQvZ1VXTEhXT0RzcFhQUHpVc1preWR0bmZHRENlKzFUemp6YUR4ek9VeFlFWjMK",
      "endpoints": [
        "https://github.com/TgolMsk/lcd-proxy/releases/latest/download/latest.json"
      ]
    }
  }
}
